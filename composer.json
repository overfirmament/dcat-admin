{
    "name": "overfirmament/dcat-admin",
    "description": "dcat admin",
    "type": "library",
    "keywords": ["dcat", "laravel", "admin", "grid", "form", "laravel admin"],
    "homepage": "https://github.com/overfirmament/dcat-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "overfirmament",
            "email": "overfirmament@163.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "spatie/eloquent-sortable": "^5.0",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-zip": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "laravel/dusk": "^8.7",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "intervention/image": "^3.11"
    },
    "suggest": {
        "dcat/easy-excel": "Excel export support (optional; verify Laravel 12/13 compatibility)",
        "intervention/image": "Image handling and thumbnails (Intervention Image v3)",
        "dcat/laravel-wherehasin": "whereHasIn query optimization (optional)",
        "dcat/laravel-softdeletes": "Enhanced soft delete support (optional)",
        "ext-gd": "Required by the Intervention Image GD driver"
    },
    "autoload": {
        "psr-4": {
            "Dcat\\Admin\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcat\\Admin\\AdminServiceProvider"
            ]
        }
    }
}
